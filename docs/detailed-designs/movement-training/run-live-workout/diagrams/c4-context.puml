@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Run live workout

Person(athlete, "Athlete", "Performs guided or free-form workout with camera, voice, and wearable telemetry")
System(haloop, "Haloop", "Local-first on-device workout studio running entirely in the browser tab")
